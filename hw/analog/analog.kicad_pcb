	(gr_text "FAB NOTES  heater analog rev B\nJLCPCB 2 layer FR-4, 1.6 mm, 1 oz finished copper (sets the heater resistance), HASL lead-free.\nThe heater is the top copper under solder mask. The underside of the heater zone is bare copper on purpose.\nSlots: internal cut-outs between heater zone and tail (2.0 mm wide), 6 plated slots 7.4 x 1.9 mm.\nThe six small pieces beside the heater zone are break-off legs of the same board (mouse-bite tabs).\nThe two 1.152 mm unplated holes in the bottom corners of the tail are assembly tooling holes.\nVias 0.6 / 0.3 mm, tented, except where they lie in the bare-copper area of the underside: the vias along three edges of the heater zone are open there. Do not add copper thieving."
		(at 155 70 0)
		(layer "Cmts.User")
		(uuid "9a466e1c-606c-46cc-9939-cb7af20c6692")
		(effects
			(font
				(size 1.2 1.2)
				(thickness 0.18)
			)
			(justify left)
		)
	)
