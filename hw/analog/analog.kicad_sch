	(text "USB-C input and PD sink"
		(exclude_from_sim no)
		(at 17.145 19.304 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3662cf80-abf0-5ded-a8f6-c9911b5de85b")
	)
	(text "RT2 above 138 °C: LIM_N goes low and stays low until 127 °C (hysteresis by R11).\nThen U3B holds the gate low and U4B shorts VSET, so the charger falls back to 5 V:\n1/16 of the heater power, even with Q1 failed short."
		(exclude_from_sim no)
		(at 17.78 159.385 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "41531056-0670-5dbe-bffb-01f36d843fe7")
	)
	(text "Comparator supply"
		(exclude_from_sim no)
		(at 273.685 19.304 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5d01d896-f950-5262-a66f-56a44e61ee82")
	)
	(text "3.3 V rail"
		(exclude_from_sim no)
		(at 182.245 19.304 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "74f885c3-0cee-52cd-bac2-93679d1444c3")
	)
	(text "HTR1 is the trace on the top side: 9.0 Ω at 20 °C, 44 W at 20 V.\nR2 slows the gate edges to about 30 µs: no flyback diode needed.\nD1 is lit while the heater is on."
		(exclude_from_sim no)
		(at 187.96 217.805 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "851597a7-3db7-54ff-8437-2e56bd2ae5f8")
	)
	(text "U1 asks the charger for the highest voltage, 20 V at most, that it offers with 2.5 A\n(ISET: R1 || R16 = 16.6k). VSET pulled to GND limits it to 5 V: the limiter's fallback.\n12 V option for small chargers: fit R15, 4.7k at R1 and no R16 (see README)."
		(exclude_from_sim no)
		(at 17.78 89.535 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "85174bf2-e0de-5fa3-a98a-c852d799ca1d")
	)
	(text "Over-temperature limiter (second sensor)"
		(exclude_from_sim no)
		(at 17.145 105.664 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "854f62fd-d837-5ae2-ae88-c01de7119d64")
	)
	(text "RV1 sets the temperature: 43 °C fully anticlockwise, 121 °C fully clockwise.\nHeater off above the set point, on again 0.9 K below it (R10)."
		(exclude_from_sim no)
		(at 71.12 222.885 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8ba90a4a-f082-5bba-a805-eb3bd6410c43")
	)
	(text "Thermostat"
		(exclude_from_sim no)
		(at 17.145 180.594 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a0e5894a-1f74-5a2a-b70b-0b826ec38d34")
	)
	(text "Heater and switch"
