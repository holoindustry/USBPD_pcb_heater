	(text "USB-C input and PD sink"
		(exclude_from_sim no)
		(at 17.145 19.304 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "f4498097-3dd8-5062-bcda-31c41e4d9fe7")
	)
	(text "U1 first takes the highest voltage that the charger offers with 2.5 A (ISET: 16.5k).\nThe MCU then reads the offers over I2C and picks the one that suits the measured heater;\nPB7 low on VSET forces 5 V."
		(exclude_from_sim no)
		(at 17.78 89.535 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a4d8038d-8ee8-5b59-88ac-9f1786a36dbd")
	)
	(text "3.3 V rail"
		(exclude_from_sim no)
		(at 17.145 108.204 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "e5e95ba1-3ee5-562b-8794-d5661ccda272")
	)
	(text "Microcontroller"
		(exclude_from_sim no)
		(at 161.925 73.914 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6cb3bcd8-a626-50aa-9686-521356a7f074")
	)
	(text "PA8: TIM1_CH1, 25 Hz PWM. PA11/PA12: bit-banged I2C to U1 (address 0x08). PB7: open drain, low = 5 V.\nPads in ST-Link order on the board: TP7 +3V3, TP8 SWDIO, TP9 SWCLK, TP10 NRST, TP11 GND. TP6: UART log."
		(exclude_from_sim no)
		(at 162.56 153.035 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6448be85-27e1-54eb-b293-4a1f7eff869c")
	)
	(text "Sensing (RT2, R11, C8: optional second sensor, not fitted)"
		(exclude_from_sim no)
		(at 240.665 19.304 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "beb054d6-6e4f-5f65-a9ef-ef64873bec5f")
	)
	(text "Heater and current sense"
		(exclude_from_sim no)
		(at 334.645 80.264 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0c75c6bf-6d6f-526e-a776-1a6ae614f9f6")
	)
	(text "HTR1: top-side trace, 9.0 Ω at 20 °C.\nR8, U4: heater current, 1 V per A;\nwith VBUS: the trace resistance,\nhence its mean temperature.\nR7 holds Q1 off during MCU reset."
		(exclude_from_sim no)
		(at 335.28 85.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c9f551c8-1697-5a88-aae1-d3f258fef8d9")
	)
