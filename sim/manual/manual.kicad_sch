		(exclude_from_sim no)
		(at 284.48 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4731a9b4-8bdf-5153-b8dd-a4aa16b0e2a4")
	)
	(text ".options method=gear"
		(exclude_from_sim no)
		(at 322.58 113.03 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ca15098f-eb33-59b2-876c-eedf0002bcd3")
	)
	(text "Inspect > Simulator, then Run. With the Tune tool turn RT1, RT2 and RV1 (position 0 to 1).\nFor finer steps, type the position (pos) into the part's simulation model.\nGATE high: heater on. LIM_N low: limiter tripped; GATE and VSET are then low as well.\n\nEvery change runs 40 ms from a fresh start, as if the plate had just been colder: C4 and C6\nstart charged (ic=3.3). The run therefore shows where things switch while warming up.\nWith ic=0 on C4 and C6 it shows where they switch back while cooling down.\n\nModels (sim/models/stock.lib): an LM393 macromodel, unchanged, and a level-1 MOSFET\nwith data-sheet values. Everything else is KiCad's own R, C, trimmer and source."
		(exclude_from_sim no)
		(at 284.48 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "65b2c3fe-9fad-5ef4-b016-ceb194b21ea2")
	)
