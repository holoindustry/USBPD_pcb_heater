	(text "Supplies"
		(exclude_from_sim no)
		(at 17.145 19.304 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "5d7d2bed-0ebd-501b-b145-55d6aee210b6")
	)
	(text "Two plain sources: V102 for the 3.3 V rail, V101 for VBUS.\nThe regulator and the PD chip are not simulated."
		(exclude_from_sim no)
		(at 17.78 80.01 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "46fe1315-1496-592b-9302-b9d3a71f71e9")
	)
	(text "The two NTCs as trimmers"
		(exclude_from_sim no)
		(at 161.925 19.304 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "3d96479c-9f87-563a-8e01-f36ae4c37755")
	)
	(text "RT1 and RT2 stand for the NTCs: resistance = position × 100 kΩ, so turning one down heats that sensor.\nThe NTC's nominal resistance (100 kΩ at 25 °C, B = 3950 K, both ±1 %) and the position for it:\n25 °C: 100k (1.000),  43 °C: 47k (0.470),  60 °C: 24.9k (0.249),  80 °C: 12.7k (0.127),\n90 °C: 9.34k (0.093),  100 °C: 6.98k (0.070),  110 °C: 5.29k (0.053),  121 °C: 3.97k (0.040),\n127 °C: 3.41k (0.034),  138 °C: 2.62k (0.026),  150 °C: 2k (0.020).\n\nWith RV1 at 0.535 the heater switches off below 6.98k and on again above 7.14k at RT1;\nthe limiter trips below 2.65k and resets above 3.43k at RT2 (from the resistor values alone)."
		(exclude_from_sim no)
		(at 165.1 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c0afd307-8f45-5ba2-8f0d-077271dba95a")
	)
	(text "Over-temperature limiter (second sensor)"
		(exclude_from_sim no)
		(at 17.145 105.664 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "6d036411-6a3d-59e4-b113-51f41e2bbc3f")
	)
	(text "RT2 too low (too hot): LIM_N goes low and stays low until RT2 is clearly higher again (R11).\nThen U3B holds the gate low and U4B pulls VSET low. On the board VSET goes to the PD chip;\nhere R102 is only a pull-up so that the output shows a level."
		(exclude_from_sim no)
		(at 17.78 159.385 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ba8b7e39-f388-5da2-852f-0f4775b79b74")
	)
	(text "Thermostat"
		(exclude_from_sim no)
		(at 17.145 180.594 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "64f37d3e-0088-5c5a-aece-4bc5ef9bf4d3")
	)
	(text "RV1 is the set-point trimmer: position 0 fully anticlockwise (coldest), 1 fully clockwise.\nHeater on while NTC1 is above REF1; R10 gives the small hysteresis."
		(exclude_from_sim no)
		(at 71.12 222.885 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "da8818cc-7ce7-59c4-bc48-66d00f9bde6c")
	)
	(text "Heater and switch"
		(exclude_from_sim no)
		(at 187.325 155.194 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0a829f01-39ca-579e-8f5b-d0e3cd098bdc")
	)
	(text "HTR1 is the heater trace as a plain resistor, its value at 20 °C.\nHTR_N near 0 V: heater on. The heater current is −I(V101)."
		(exclude_from_sim no)
		(at 187.96 217.805 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9ae72bb2-898f-59a9-86e6-0289c7914d49")
	)
	(text "Simulation"
		(exclude_from_sim no)
		(at 283.845 105.664 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7d96fee3-9080-520b-abce-c5bf67b19e1e")
	)
